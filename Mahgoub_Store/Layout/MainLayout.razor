@inherits LayoutComponentBase
@implements IDisposable
@inject TenantHostService Host
@inject StoreApiClient Api
@inject CartService Cart
@inject StoreBrandHub Brand
@inject StoreRunGate Run
@inject NavigationManager Nav

<div class="store-shell @(Run.IsRunning ? "is-running" : null)" style="@BrandStyle">
    <header class="store-header">
        <a class="brand" href="@HomeHref">
            @if (!string.IsNullOrWhiteSpace(_logoSrc))
            {
                <img class="brand__logo" src="@_logoSrc" alt="@_storeName" />
            }
            <span class="brand__name">@_storeName</span>
            @if (_discount > 0)
            {
                <span class="sale-badge sale-badge--header">خصم @_discount%</span>
            }
        </a>
        <a class="cart-chip" href="@Host.CartUrl()" aria-label="السلة">
            <svg class="cart-chip__svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#ffffff" d="M7 18a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 18zm10 0a2 2 0 1 0 .001 4.001A2 2 0 0 0 17 18zM6.2 6l.4 2h12.7a1 1 0 0 1 .97.757l1.2 6A1 1 0 0 1 20.5 16H8.1a1 1 0 0 1-.97-.757L5.2 4H3a1 1 0 1 1 0-2h2.8a1 1 0 0 1 .97.757L6.2 6z"/>
            </svg>
            <span class="cart-chip__label">السلة</span>
            @if (Cart.TotalQty > 0)
            {
                <span class="cart-chip__count">@Cart.TotalQty</span>
            }
        </a>
    </header>
    <main class="store-main">
        @Body
    </main>
    @if (Run.IsRunning)
    {
        <div class="run-veil" role="status" aria-live="polite">جاري إرسال الطلب…</div>
    }
</div>

@code {
    private string _storeName = "أنظمة محجوب";
    private string _color = StoreBrandCss.MahgoubNavy;
    private string? _logoSrc = "logo.svg";
    private int _discount;
    private string? _slug;
    private string HomeHref => Host.HomeUrl();

    private string BrandStyle => StoreBrandCss.ShellStyle(_color);

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += OnCart;
        Brand.Changed += OnBrand;
        Run.Changed += OnRun;
        _slug = Host.ResolveSlug();
        if (string.IsNullOrWhiteSpace(_slug))
        {
            ApplyMahgoub();
            return;
        }

        if (Brand.Current is not null)
            Apply(Brand.Current);
        await Api.EnsureSessionAsync(_slug);
    }

    private void OnRun() => InvokeAsync(StateHasChanged);

    private void OnBrand() => InvokeAsync(() =>
    {
        if (Brand.Current is not null)
            Apply(Brand.Current);
    });

    private void Apply(StoreBootstrapDto boot)
    {
        if (!boot.Available)
        {
            ApplyMahgoub();
            return;
        }

        _storeName = string.IsNullOrWhiteSpace(boot.Name) ? "المتجر" : boot.Name;
        _color = StoreBrandCss.NormalizeHex(boot.PrimaryColor);
        _logoSrc = boot.HasLogo && !string.IsNullOrWhiteSpace(_slug) ? Api.LogoUrl(_slug) : null;
        _discount = boot.DiscountPercent;
        StateHasChanged();
    }

    private void ApplyMahgoub()
    {
        _storeName = "أنظمة محجوب";
        _color = StoreBrandCss.MahgoubNavy;
        _logoSrc = "logo.svg";
        _discount = 0;
        StateHasChanged();
    }

    private void OnCart() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cart.Changed -= OnCart;
        Brand.Changed -= OnBrand;
        Run.Changed -= OnRun;
    }
}
