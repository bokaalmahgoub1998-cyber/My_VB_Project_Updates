@page "/"
@page "/{tenantSlug}"
@using Mahgoub_Store.Components
@using Mahgoub_Store.Helpers
@implements IDisposable
@inject TenantHostService Host
@inject IJSRuntime JS
@inject StoreApiClient Api
@inject CartService Cart
@inject MenuCacheService Cache
@inject OrderLockService Locks
@inject StoreBrandHub Brand
@inject NavigationManager Nav

<PageTitle>@_title</PageTitle>

@if (!string.IsNullOrWhiteSpace(_blocked))
{
    <EmptyState Title="المتجر غير متاح" Message="@_blocked" />
}
else if (_loading)
{
    <EmptyState Title="أنظمة محجوب" Message="جاري تحميل القائمة…" />
}
else
{
    <div class="menu-tools">
        <label class="menu-search">
            <span class="menu-search__ico" aria-hidden="true">⌕</span>
            <input type="search" inputmode="search" autocomplete="off"
                   placeholder="ابحث عن صنف…" value="@_q" @oninput="OnSearch" />
        </label>
    </div>
    <section class="cats" aria-label="التصنيفات">
        <button class="chip @( _cat == 0 ? "chip--on" : null)" @onclick="() => SelectCat(0)">الكل</button>
        @foreach (var c in _catalog.Categories)
        {
            <button class="chip @( _cat == c.Id ? "chip--on" : null)" @onclick="() => SelectCat(c.Id)">@c.Name</button>
        }
    </section>
    @if (_queryLoading && !VisibleItems.Any())
    {
        <EmptyState Title="@_title" ShowBrandLogo="false" Message="جاري البحث…" />
    }
    else if (!VisibleItems.Any())
    {
        <EmptyState Title="@_title"
                    ShowBrandLogo="false"
                    Message="@(string.IsNullOrWhiteSpace(_q) ? "لا توجد أصناف متاحة للعرض حالياً." : "لا توجد أصناف مطابقة للبحث.")" />
    }
    else
    {
    <section class="grid" aria-label="المنتجات">
        @foreach (var item in VisibleItems)
        {
            <article class="card">
                <div class="card__media">
                    @if (item.HasImage && !string.IsNullOrWhiteSpace(_slug))
                    {
                        <img src="@Api.ImageUrl(_slug, item.Id)" alt="@item.Name" loading="lazy" decoding="async" />
                    }
                </div>
                <div class="card__body">
                    <h2>@item.Name</h2>
                    @if (item.DiscountPercent > 0)
                    {
                        <p class="price price--sale">
                            <span class="price__old">@item.Price.ToString("0.##") د.ل</span>
                            <span>@item.EffectivePrice.ToString("0.##") د.ل</span>
                            <span class="sale-badge">خصم @item.DiscountPercent%</span>
                        </p>
                    }
                    else
                    {
                        <p class="price">@item.Price.ToString("0.##") د.ل</p>
                    }
                    <button class="btn" type="button" @onclick="() => AddToCart(item)">أضف للسلة</button>
                    <div class="tile-bar">
                        <button type="button" class="qty-step" aria-label="زيادة" @onclick="() => Plus(item.Id)">+</button>
                        <span class="qty-val">@QtyOf(item.Id)</span>
                        <button type="button" class="qty-step" aria-label="نقص" @onclick="() => Minus(item.Id)">−</button>
                    </div>
                    <input class="note note--card" maxlength="200" placeholder="ملاحظة على الصنف (اختياري)"
                           value="@NoteOf(item.Id)" @onchange="e => SetNote(item.Id, e)" />
                </div>
            </article>
        }
    </section>
    }
    @if (MoreAvailable)
    {
        <div class="more-sentinel" @ref="_more"></div>
    }
}

@code {
    [Parameter] public string? TenantSlug { get; set; }

    private string? _slug;
    private string _title = "المتجر";
    private string? _blocked;
    private bool _loading = true;
    private int _cat;
    private string _q = "";
    private StoreCatalogDto _catalog = new();
    private StoreCatalogDto? _query;
    private bool _queryLoading;
    private int _queryGen;
    private CancellationTokenSource? _searchCts;
    private readonly Dictionary<int, int> _qty = new();
    private readonly Dictionary<int, string> _note = new();

    private bool UseQuery => _q.Trim().Length > 0 || _cat != 0;

    private IEnumerable<StoreItemDto> VisibleItems =>
        UseQuery ? (_query?.Items ?? []) : _catalog.Items;

    private bool MoreAvailable =>
        UseQuery
            ? _query is not null && _query.Items.Count < _query.Total
            : !Cache.IsComplete;

    private int QtyOf(int id) => _qty.TryGetValue(id, out var q) ? q : 1;
    private string NoteOf(int id) => _note.TryGetValue(id, out var n) ? n : "";

    private async Task SelectCat(int id)
    {
        _cat = id;
        _query = null;
        if (!UseQuery)
            return;
        await LoadQueryAsync(reset: true);
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try { await Task.Delay(280, token); }
        catch (OperationCanceledException) { return; }
        _query = null;
        if (!UseQuery)
            return;
        await LoadQueryAsync(reset: true);
    }

    private void Plus(int id) => _qty[id] = Math.Clamp(QtyOf(id) + 1, 1, 99);
    private void Minus(int id) => _qty[id] = Math.Clamp(QtyOf(id) - 1, 1, 99);

    private void SetNote(int id, ChangeEventArgs e) =>
        _note[id] = StoreSafeText.ItemNote(e.Value?.ToString());

    private void AddToCart(StoreItemDto item)
    {
        Cart.Add(item, QtyOf(item.Id), StoreSafeText.ItemNote(NoteOf(item.Id)));
        _qty[item.Id] = 1;
        _note[item.Id] = "";
    }

    protected override async Task OnInitializedAsync()
    {
        _slug = Host.ResolveSlug();
        _ = TenantSlug;
        if (string.IsNullOrWhiteSpace(_slug))
        {
            _blocked = "لم يتم التعرف على المتجر.";
            _loading = false;
            return;
        }

        var lockState = await Locks.LoadAsync(_slug);
        if (lockState is not null)
        {
            Nav.NavigateTo(Host.CartUrl());
            return;
        }

        await Cache.RestoreAsync(_slug);
        if (Cache.HasItems && Cache.Catalog is not null)
        {
            _catalog = Cache.Catalog;
            _title = string.IsNullOrWhiteSpace(Brand.Current?.Name) ? _title : Brand.Current!.Name;
            _loading = false;
            _ = ConfirmStoreAsync(fetchPage: false);
            return;
        }

        await ConfirmStoreAsync(fetchPage: true);
    }

    private async Task ConfirmStoreAsync(bool fetchPage)
    {
        await Api.EnsureSessionAsync(_slug!);
        var boot = Brand.Current;
        if (boot is not { Available: true })
        {
            _blocked = boot?.Message ?? "هذا المتجر غير متاح حالياً، يرجى الزيارة لاحقاً";
            _loading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _title = boot.Name;
        if (fetchPage && !Cache.HasItems && !await LoadPageAsync(0))
            _blocked = "المتجر غير متاح حالياً، يرجى الزيارة لاحقاً";

        if (_catalog.DiscountPercent > 0 && Brand.Current is { Available: true } live)
        {
            live.DiscountPercent = Math.Max(live.DiscountPercent, _catalog.DiscountPercent);
            Brand.Publish(live);
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private ElementReference _more;
    private bool _loadingMore;
    private DotNetObjectReference<Home>? _self;

    private async Task<bool> LoadPageAsync(int skip)
    {
        if (_loadingMore || string.IsNullOrWhiteSpace(_slug))
            return false;
        _loadingMore = true;
        try
        {
            var page = await Api.CatalogAsync(_slug, skip, 24);
            if (page is null)
                return false;
            Cache.Merge(page);
            _catalog = Cache.Catalog ?? page;
            if (!string.IsNullOrWhiteSpace(_slug))
                await Cache.PersistAsync(_slug);
            return page.Items.Count > 0 || page.Total == 0;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task LoadQueryAsync(bool reset)
    {
        if (string.IsNullOrWhiteSpace(_slug) || !UseQuery)
            return;
        if (!reset && _queryLoading)
            return;
        int gen = ++_queryGen;
        int skip = reset || _query is null ? 0 : _query.Items.Count;
        _queryLoading = true;
        try
        {
            var page = await Api.CatalogAsync(_slug, skip, 24, _q.Trim(), _cat);
            if (gen != _queryGen || page is null)
                return;
            if (reset || _query is null)
                _query = page;
            else
            {
                var ids = _query.Items.Select(i => i.Id).ToHashSet();
                foreach (var item in page.Items)
                {
                    if (ids.Add(item.Id))
                        _query.Items.Add(item);
                }
                _query.Total = page.Total;
            }
        }
        finally
        {
            if (gen == _queryGen)
                _queryLoading = false;
        }
    }

    [JSInvokable]
    public async Task LoadMore()
    {
        if (_loadingMore || _queryLoading || _loading)
            return;
        if (UseQuery)
        {
            if (_query is null || _query.Items.Count >= _query.Total)
                return;
            await LoadQueryAsync(reset: false);
        }
        else
        {
            if (Cache.IsComplete)
                return;
            await LoadPageAsync(_catalog.Items.Count);
        }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!MoreAvailable || _loading || !string.IsNullOrWhiteSpace(_blocked))
            return;
        _self ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("mahgoubMore.observe", _more, _self);
        }
        catch
        {
            /* المراقبة تُعاد في الرسم التالي */
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _self?.Dispose();
    }
}
